# Приводить окончания строк к одному виду независимо от того, кто правил файл.
# В репозитории хранится LF, в рабочей копии — CRLF (Windows).
* text=auto

# Исходники и проектные файлы — всегда CRLF на диске
*.cpp   text eol=crlf
*.h     text eol=crlf
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.vcxproj        text eol=crlf
*.filters        text eol=crlf

# Бинарное не трогать
*.png   binary
*.jpg   binary
*.dll   binary
*.lib   binary
*.exe   binary
*.ttf   binary
*.ogg   binary
*.wav   binary

# Скрипты Windows — тоже CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf
